# Don't run dependencies' install scripts (preinstall/install/postinstall).
# Guards against compromised packages executing code during `npm install`.
ignore-scripts=true

# Record exact versions (1.2.3) instead of ranges (^1.2.3) when adding packages.
save-exact=true

# Install only versions published at least 7 days ago, for every package in the
# tree (most compromised releases are caught and pulled within days). Override
# for one install with --min-release-age=<days> when a newer fix is needed.
min-release-age=7
